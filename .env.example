BASE_URL=https://parabank.parasoft.com/parabank/
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Una sola definición por variable. Completar cuentas del usuario de prueba actual.
PARABANK_FROM_ACCOUNT=
PARABANK_TO_ACCOUNT=

# Dos escenarios de apertura: dos depósitos mínimos + USD 3 de saldo inicial.
# Ejecutar con un worker, un navegador y cero reintentos.
RUN_OPEN_ACCOUNT_FLOW=false

# Transferencia CP-06 entre dos cuentas distintas configuradas.
RUN_BANK_MUTATIONS=false

# Dos rechazos de importe inválido; requieren dos cuentas de prueba distintas.
RUN_TRANSFER_NEGATIVE=false
